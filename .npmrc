# Lock to the npm registry; never silently fall back to a mirror.
registry=https://registry.npmjs.org/

# Run lifecycle scripts only for explicitly trusted packages. Reduces
# supply-chain risk from malicious postinstall scripts.
ignore-scripts=false

# Use exact engine match for the Node version pinned in .nvmrc. CI will
# fail loudly if a teammate's local Node drifts from the lockfile range.
engine-strict=true

# Save package versions exactly (no caret/tilde). Combined with a committed
# package-lock.json, this gives fully reproducible installs.
save-exact=true

# Show full audit results on install, but don't auto-block — CI runs
# `npm audit --audit-level=high` as a separate gate.
audit-level=moderate

# Faster, more deterministic installs on CI runners.
fund=false
update-notifier=false
