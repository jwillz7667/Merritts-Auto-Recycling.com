{
  "name": "merritts-auto-recycling",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing site for Merritt's Auto Recycling (Twin Cities, MN). Hosted on Vercel.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vercel dev",
    "preview": "vercel",
    "deploy": "vercel --prod",
    "build": "npm run build:images && npm run build:placemarks && npm run build:blog && npm run build:shared && npm run build:sitemap && npm run build:llms",
    "build:images": "tsx scripts/optimize-images.mts",
    "build:placemarks": "tsx scripts/build-placemarks.mts",
    "build:blog": "tsx scripts/build-blog.mts",
    "build:shared": "tsx scripts/apply-shared-blocks.mts",
    "build:sitemap": "tsx scripts/build-sitemap.mts",
    "build:llms": "tsx scripts/build-llms.mts",
    "build:env": "tsx scripts/apply-env.mts",
    "build:performance": "tsx scripts/apply-performance.mts",
    "vercel-build": "npm run build && npm run build:performance && npm run build:env",
    "validate": "tsx scripts/validate-schema.mts",
    "lighthouse": "tsx scripts/lighthouse-check.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.mts,.mjs,.js",
    "typecheck": "tsc --noEmit",
    "prepare": "test -d node_modules/husky && husky install || true"
  },
  "dependencies": {
    "resend": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/node": "^5.1.0",
    "cheerio": "^1.0.0",
    "chrome-launcher": "^1.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.6",
    "lighthouse": "^12.2.1",
    "lint-staged": "^15.2.10",
    "markdownlint-cli": "^0.42.0",
    "prettier": "^3.3.3",
    "sharp": "^0.33.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vercel": "^39.1.0"
  }
}
