{
  "name": "merritts-auto-recycling",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "displayName": "Merritt's Auto Recycling",
  "description": "Static-first website for Merritt's Auto Recycling in Brooklyn Center, Minnesota.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/validate-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "node scripts/check-sensitive-data.mjs",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.sites-runtime/playwright playwright test",
    "test:all": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@vercel/node": "^5.5.27",
    "astro": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.9.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
