# Normalize line endings — every file gets LF on commit, regardless of
# author's OS. Prevents the "entire file shows as changed" diff noise.
* text=auto eol=lf

# Source — always LF
*.ts        text eol=lf
*.mts       text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
*.svg       text eol=lf

# Windows scripts still need CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary — never line-ending convert, never diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.mp4       binary
*.mov       binary
*.webm      binary

# Generated files — hide from diffs in PR review (still tracked)
package-lock.json    -diff linguist-generated=true
sitemap.xml          linguist-generated=true
llms.txt             linguist-generated=true
llms-full.txt        linguist-generated=true
images/optimized/**  linguist-generated=true

# Vendored — keep but exclude from language stats
css/plugins/**       linguist-vendored=true
js/plugins/**        linguist-vendored=true
iconfont/**          linguist-vendored=true

# Export-ignore — these don't ship in tarball / archive
.gitattributes       export-ignore
.gitignore           export-ignore
.github              export-ignore
.husky               export-ignore
.vscode              export-ignore
.editorconfig        export-ignore
.eslintrc.cjs        export-ignore
.prettierrc          export-ignore
.prettierignore      export-ignore
.nvmrc               export-ignore
.env.example         export-ignore
CONTRIBUTING.md      export-ignore
CHANGELOG.md         export-ignore
CODEOWNERS           export-ignore
SECURITY.md          export-ignore
