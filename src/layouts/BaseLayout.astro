---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import MobileCta from '@/components/MobileCta.astro';
import Analytics from '@/components/Analytics.astro';
import { areaServedSchema, business, serviceAreas } from '@/data/site';
import { serviceRegions } from '@/data/service-regions';
import '@/styles/global.css';
interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  ogImage?: string;
  ogImageAlt?: string;
}
const { title, description, path = Astro.url.pathname, noindex = false, schema = [], ogImage = '/images/legacy/merritts-tow-truck.jpg', ogImageAlt = "Merritt's Auto Recycling truck carrying a vehicle" } = Astro.props;
const canonical = new URL(path, business.siteUrl).toString();
const absoluteImage = new URL(ogImage, business.siteUrl).toString();
const pageSchemas = Array.isArray(schema) ? schema : [schema];
const breadcrumbLabels: Record<string, string> = {
  about: 'About', 'auto-recycling': 'Auto recycling', 'cash-for-junk-cars': 'Cash for junk cars',
  contact: 'Contact', faq: 'FAQ', guides: 'Guides', 'junk-car-removal': 'Junk car removal',
  'junk-car-towing': 'Junk car towing', privacy: 'Privacy', reviews: 'Reviews', 'service-areas': 'Service areas',
  'service-regions': 'Regional pickup information',
  ...Object.fromEntries(serviceAreas.map((area) => [area.slug, area.city])),
  ...Object.fromEntries(serviceRegions.map((region) => [region.slug, region.name])),
};
const pathSegments = path.split('/').filter(Boolean);
const hasBreadcrumbSchema = pageSchemas.some((item) => item['@type'] === 'BreadcrumbList');
const automaticBreadcrumb = !noindex && path !== '/' && !hasBreadcrumbSchema ? {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.siteUrl}/` },
    ...pathSegments.map((segment, index) => ({
      '@type': 'ListItem', position: index + 2,
      name: breadcrumbLabels[segment] ?? segment.replaceAll('-', ' ').replace(/^./, (letter) => letter.toUpperCase()),
      item: new URL(`/${pathSegments.slice(0, index + 1).join('/')}`, business.siteUrl).toString(),
    })),
  ],
} : null;
const localBusinessSchema = {
  '@type': ['LocalBusiness', 'AutomotiveBusiness'], '@id': `${business.siteUrl}/#business`,
  name: business.name, legalName: business.legalName, url: `${business.siteUrl}/`,
  logo: `${business.siteUrl}/brand/mark.svg`, image: `${business.siteUrl}/images/legacy/merritts-tow-truck.jpg`,
  description: 'Brooklyn Center vehicle buyer serving Minneapolis, St. Paul and surrounding Twin Cities communities with cash offers and pickup for unwanted vehicles.',
  telephone: '+1-763-533-2775', email: business.email,
  contactPoint: [{ '@type': 'ContactPoint', telephone: '+1-763-533-2775', contactType: 'customer service', availableLanguage: ['English'] }],
  address: { '@type': 'PostalAddress', streetAddress: business.address.street, addressLocality: business.address.city, addressRegion: business.address.region, postalCode: business.address.postalCode, addressCountry: business.address.country },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: business.openingHours.days.map((day) => `https://schema.org/${day}`), opens: business.openingHours.opens, closes: business.openingHours.closes }],
  founder: { '@type': 'Person', name: business.founder }, foundingDate: business.foundingDate,
  areaServed: areaServedSchema,
  sameAs: [business.googleBusinessProfile, business.facebook], hasMap: business.googleMaps,
};
const webSiteSchema = { '@type': 'WebSite', '@id': `${business.siteUrl}/#website`, url: `${business.siteUrl}/`, name: business.name, publisher: { '@id': `${business.siteUrl}/#business` }, inLanguage: 'en-US' };
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [localBusinessSchema, webSiteSchema, ...pageSchemas, ...(automaticBreadcrumb ? [automaticBreadcrumb] : [])] }).replaceAll('<', '\\u003c');
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=yes" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:secure_url" content={absoluteImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A1C2D" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <MobileCta />
    <Analytics />
    <script>
      import '@/scripts/forms';
      import { track } from '@/scripts/tracking';
      track('site_page_view');
      const trackedEvents = new Set(['call_click', 'text_click', 'review_profile_click']);
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-track]') : null;
        if (!target || !trackedEvents.has(target.dataset.track ?? '')) return;
        const placement = target.closest('.mobile-cta') ? 'mobile' : target.closest('.hero, .page-hero') ? 'hero' : target.closest('header') ? 'header' : target.closest('footer') ? 'footer' : target.closest('.cta-band') ? 'cta_band' : 'body';
        track(target.dataset.track!, { link_url: target instanceof HTMLAnchorElement ? target.href : undefined, cta_location: placement });
      });
    </script>
  </body>
</html>
