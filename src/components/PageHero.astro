---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  crumbs?: Array<{ label: string; href?: string }>;
}

const { eyebrow, title, description, crumbs = [] } = Astro.props;
---

<header class="page-hero">
  <div class="container">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <p class="eyebrow eyebrow--light">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede lede--light">{description}</p>
    <slot />
  </div>
</header>
