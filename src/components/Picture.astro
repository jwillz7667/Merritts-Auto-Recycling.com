---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  avif?: string;
  webp?: string;
  avifSrcset?: string;
  webpSrcset?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  avif,
  webp,
  avifSrcset,
  webpSrcset,
  sizes,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
} = Astro.props;
---

<picture class={className}>
  {avif && <source srcset={avifSrcset ?? avif} sizes={sizes} type="image/avif" />}
  {webp && <source srcset={webpSrcset ?? webp} sizes={sizes} type="image/webp" />}
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
