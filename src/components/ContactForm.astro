---
const siteKey = import.meta.env.TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<div class="form-shell" id="vehicle-inquiry" data-form-shell>
  <h2>Send vehicle details or a question</h2>
  <p class="form-intro">Tell us what you have and where it is parked. Include the year, make, model, known condition, pickup city and title status in your message. Merritt’s will respond to discuss the next step; submitting does not book a pickup.</p>
  <form class="lead-form" method="post" action="/api/contact" data-lead-form="contact" data-success-url="/thank-you?form=contact" novalidate>
    <div class="form-grid">
      <div class="field"><label for="contact-name">Name <span class="required" aria-hidden="true">*</span></label><input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required /></div>
      <div class="field"><label for="contact-phone">Phone <span class="required" aria-hidden="true">*</span></label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" minlength="7" maxlength="30" required /></div>
      <div class="field"><label for="contact-email">Email <span class="required" aria-hidden="true">*</span></label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="200" required /></div>
      <div class="field"><label for="contact-subject">Subject <span class="required" aria-hidden="true">*</span></label><select id="contact-subject" name="subject" required><option value="vehicle-question" selected>Sell a vehicle or ask about an offer</option><option value="pickup-question">Confirmed pickup question</option><option value="document-question">Title or document question</option><option value="website-question">Website or privacy question</option><option value="other">Other</option></select></div>
      <div class="field field--full"><label for="contact-message">Vehicle details or message <span class="required" aria-hidden="true">*</span></label><textarea id="contact-message" name="message" minlength="10" maxlength="4000" rows="7" required aria-describedby="vehicle-message-help" placeholder="Year, make and model&#10;Known condition or missing parts&#10;Pickup city and parking setting&#10;Whether it rolls and steers&#10;Title and key status"></textarea><p class="field-hint" id="vehicle-message-help">Do not send identification documents, a full VIN, Social Security number or payment-card information. Describe document status only; any required originals are handled separately.</p></div>
      <div class="field field--full honeypot" aria-hidden="true"><label for="contact-company">Company website</label><input id="contact-company" name="companyWebsite" type="text" tabindex="-1" autocomplete="off" /></div>
      <div class="field field--full checkbox"><input id="contact-consent" name="contactConsent" type="checkbox" value="true" required /><label for="contact-consent">I agree Merritt’s may use this information to respond by phone, text or email. Message and data rates may apply.</label></div>
    </div>
    {siteKey ? <div class="turnstile-wrap"><div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-size="flexible" /></div> : <p class="form-unavailable">The secure form is temporarily unavailable. Please call or text using the contact links on this page.</p>}
    <div class="form-actions"><button class="button button--dark" type="submit" disabled={!siteKey}>Send vehicle inquiry</button><span class="field-hint">Required fields are marked with an asterisk.</span></div>
    <p class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status></p>
  </form>
</div>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
