---
import { business } from '@/data/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to talk through the vehicle?',
  text = 'Call for the fastest response or send a text during daily business hours.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="container cta-band-inner">
    <div>
      <h2 id="cta-heading">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="button-row">
      <a class="button button--dark" href={business.phoneUri} data-track="call_click">
        <Icon name="phone" /> Call {business.phone}
      </a>
      <a class="button button--light" href={business.textUri} data-track="text_click"
        ><Icon name="message" /> Text {business.textPhone}</a
      >
    </div>
  </div>
</section>
