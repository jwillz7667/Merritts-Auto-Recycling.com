---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { areaServedSchema, business, type Service } from '@/data/site';
import { guides, type Guide } from '@/data/guides';
import CoverageDirectory from './CoverageDirectory.astro';
import CtaBand from './CtaBand.astro';
import FaqList from './FaqList.astro';
import Icon from './Icon.astro';
import PageHero from './PageHero.astro';
import Picture from './Picture.astro';
interface Props { service: Service }
const { service } = Astro.props;
const path = `/${service.slug}`;
const imageIsTruck = service.image === '/images/legacy/merritts-tow-truck.jpg';
const guideSlugs = service.slug === 'auto-recycling'
  ? ['repair-trade-in-or-sell-a-junk-car', 'scrap-car-value-by-weight', 'what-happens-after-junk-car-pickup']
  : ['non-running-car-removal-checklist', 'what-affects-a-junk-car-offer', 'cash-for-junkers-mn-vs-merritts'];
const questionGuides = guideSlugs.map((slug) => guides.find((guide) => guide.slug === slug)).filter((guide): guide is Guide => Boolean(guide));
const schema = {
  '@type': 'Service', '@id': `${business.siteUrl}${path}#service`, name: service.name,
  serviceType: service.name, description: service.description, url: `${business.siteUrl}${path}`,
  provider: { '@id': `${business.siteUrl}/#business` }, areaServed: areaServedSchema,
};
---
<BaseLayout title={service.seoTitle} description={service.description} path={path} schema={schema} ogImage={service.image} ogImageAlt={service.imageAlt}>
  <PageHero eyebrow={service.eyebrow} title={service.title} description={service.summary} crumbs={[{ label: 'Home', href: '/' }, { label: service.name }]}>
    <div class="button-row"><a class="button" href={business.phoneUri} data-track="call_click"><Icon name="phone" /> Call {business.phone}</a><a class="button button--outline-light" href={business.textUri} data-track="text_click"><Icon name="message" /> Text {business.textPhone}</a></div>
    <ul class="highlight-list" aria-label="Service highlights">{service.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
  </PageHero>
  <section class="section section--paper"><div class="container split">
    <div class="flow"><p class="eyebrow">Minneapolis, St. Paul and the metro</p><h2>Talk directly with a local vehicle buyer</h2><p class="lede">Merritt’s has served vehicle owners since 1988. Call or text during daily business hours to discuss your car and its pickup location.</p><p>We explain the offer, any removal charges, payment arrangements, and documents before you decide. A pickup window is agreed after the vehicle and access have been reviewed.</p><a class="text-link" href={business.googleBusinessProfile} target="_blank" rel="noopener noreferrer" data-track="review_profile_click">Read our customer reviews on Google <Icon name="arrow" /></a></div>
    <div class="media-frame"><Picture src={service.image} avif={imageIsTruck ? '/images/legacy/merritts-tow-truck.avif' : undefined} webp={imageIsTruck ? '/images/legacy/merritts-tow-truck.webp' : undefined} alt={service.imageAlt} width={imageIsTruck ? 1600 : 1920} height={imageIsTruck ? 1070 : 865} /></div>
  </div></section>
  <section class="section section--soft"><div class="container content-sections">{service.sections.map((section) => <article class="content-section"><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}</article>)}</div></section>
  <section class="section section--paper"><div class="container flow"><h2>Find pickup information for your city</h2><p>Explore local access and preparation information, or use the full directory to find your community.</p><CoverageDirectory compact /></div></section>
  <section class="section section--soft" aria-labelledby="service-faq-heading"><div class="container--narrow"><p class="eyebrow">Common questions</p><h2 id="service-faq-heading">Before you sell your vehicle</h2><FaqList faqs={service.faqs} /><p style="margin-top: 1.5rem;"><a class="text-link" href="/guides">Read our vehicle-selling guides <Icon name="arrow" /></a></p></div></section>
  <section class="section section--paper" aria-labelledby="selling-questions-heading"><div class="container flow"><p class="eyebrow">Compare your next steps</p><h2 id="selling-questions-heading">Answers to common vehicle-selling questions</h2><div class="card-grid">{questionGuides.map((guide) => <article class="card"><h3>{guide.shortTitle}</h3><p>{guide.description}</p><a class="text-link" href={`/guides/${guide.slug}`}>{guide.shortTitle} <Icon name="arrow" /></a></article>)}</div></div></section>
  <CtaBand />
</BaseLayout>
