---
interface Props {
  heading?: string;
  compact?: boolean;
}

const { heading = 'Request a cash offer', compact = false } = Astro.props;
const siteKey =
  import.meta.env.TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<div class="form-shell" data-form-shell>
  <h2>{heading}</h2>
  <p class="form-intro">
    Send the basics. Merritt’s will review the request and confirm any offer and removal terms
    directly. This is not a pickup appointment.
  </p>

  <form
    class="lead-form"
    method="post"
    action="/api/quote"
    data-lead-form="quote"
    data-success-url="/thank-you?form=quote"
    novalidate
  >
    <div class="form-grid">
      <div class="field">
        <label for={`quote-name${compact ? '-compact' : ''}`}
          >Name <span class="required" aria-hidden="true">*</span></label
        >
        <input
          id={`quote-name${compact ? '-compact' : ''}`}
          name="name"
          type="text"
          autocomplete="name"
          minlength="2"
          maxlength="100"
          required
        />
      </div>
      <div class="field">
        <label for={`quote-phone${compact ? '-compact' : ''}`}
          >Phone <span class="required" aria-hidden="true">*</span></label
        >
        <input
          id={`quote-phone${compact ? '-compact' : ''}`}
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          minlength="7"
          maxlength="30"
          required
        />
      </div>
      <div class="field">
        <label for={`quote-email${compact ? '-compact' : ''}`}
          >Email <span class="required" aria-hidden="true">*</span></label
        >
        <input
          id={`quote-email${compact ? '-compact' : ''}`}
          name="email"
          type="email"
          autocomplete="email"
          maxlength="200"
          required
        />
      </div>
      <div class="field">
        <label for={`quote-city${compact ? '-compact' : ''}`}
          >Vehicle city <span class="required" aria-hidden="true">*</span></label
        >
        <input
          id={`quote-city${compact ? '-compact' : ''}`}
          name="city"
          type="text"
          autocomplete="address-level2"
          minlength="2"
          maxlength="80"
          required
        />
      </div>
      <div class="field">
        <label for={`quote-year${compact ? '-compact' : ''}`}
          >Year <span class="required" aria-hidden="true">*</span></label
        >
        <input
          id={`quote-year${compact ? '-compact' : ''}`}
          name="year"
          type="text"
          inputmode="numeric"
          pattern="(19|20)[0-9]{2}"
          maxlength="4"
          placeholder="e.g. 2012"
          required
        />
      </div>
      <div class="field">
        <label for={`quote-make${compact ? '-compact' : ''}`}
          >Make <span class="required" aria-hidden="true">*</span></label
        >
        <input
          id={`quote-make${compact ? '-compact' : ''}`}
          name="make"
          type="text"
          maxlength="60"
          placeholder="e.g. Ford"
          required
        />
      </div>
      <div class="field">
        <label for={`quote-model${compact ? '-compact' : ''}`}
          >Model <span class="required" aria-hidden="true">*</span></label
        >
        <input
          id={`quote-model${compact ? '-compact' : ''}`}
          name="model"
          type="text"
          maxlength="60"
          placeholder="e.g. Escape"
          required
        />
      </div>
      <div class="field">
        <label for={`quote-condition${compact ? '-compact' : ''}`}
          >Vehicle condition <span class="required" aria-hidden="true">*</span></label
        >
        <select id={`quote-condition${compact ? '-compact' : ''}`} name="condition" required>
          <option value="">Choose one</option>
          <option value="runs">Runs and drives</option>
          <option value="starts">Starts but does not drive</option>
          <option value="not-running">Does not run</option>
          <option value="damaged">Collision or major damage</option>
          <option value="unknown">Not sure</option>
        </select>
      </div>
      <div class="field">
        <label for={`quote-title${compact ? '-compact' : ''}`}
          >Title status <span class="required" aria-hidden="true">*</span></label
        >
        <select id={`quote-title${compact ? '-compact' : ''}`} name="titleStatus" required>
          <option value="">Choose one</option>
          <option value="in-hand">Title in my name and in hand</option>
          <option value="lost-damaged">Lost or damaged title</option>
          <option value="lien">Lien or lender listed</option>
          <option value="other-name">Title is in another name</option>
          <option value="unknown">Not sure</option>
        </select>
      </div>
      <div class="field">
        <label for={`quote-contact${compact ? '-compact' : ''}`}
          >Preferred reply <span class="required" aria-hidden="true">*</span></label
        >
        <select id={`quote-contact${compact ? '-compact' : ''}`} name="preferredContact" required>
          <option value="">Choose one</option>
          <option value="phone">Phone call</option>
          <option value="text">Text message</option>
          <option value="email">Email</option>
        </select>
      </div>
      <div class="field field--full">
        <label for={`quote-notes${compact ? '-compact' : ''}`}
          >Damage, access, or other details</label
        >
        <textarea
          id={`quote-notes${compact ? '-compact' : ''}`}
          name="notes"
          maxlength="2000"
          placeholder="Tell us whether it rolls and steers, where it is parked, and about major damage or missing parts."
        ></textarea>
        <p class="field-hint">
          Do not include a Social Security number, payment-card number, or photo ID.
        </p>
      </div>
      <div class="field field--full honeypot" aria-hidden="true">
        <label for={`quote-company${compact ? '-compact' : ''}`}>Company website</label>
        <input
          id={`quote-company${compact ? '-compact' : ''}`}
          name="companyWebsite"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <div class="field field--full checkbox">
        <input
          id={`quote-consent${compact ? '-compact' : ''}`}
          name="contactConsent"
          type="checkbox"
          value="true"
          required
        />
        <label for={`quote-consent${compact ? '-compact' : ''}`}>
          I agree Merritt’s may use this information to respond by phone, text, or email. Message
          and data rates may apply. Consent is not a condition of accepting an offer.
        </label>
      </div>
    </div>

    {
      siteKey ? (
        <div class="turnstile-wrap">
          <div
            class="cf-turnstile"
            data-sitekey={siteKey}
            data-theme="light"
            data-size="flexible"
          />
        </div>
      ) : (
        <p class="form-unavailable">
          Secure form verification is not configured in this preview. Please call instead.
        </p>
      )
    }

    <div class="form-actions">
      <button class="button button--dark" type="submit" disabled={!siteKey}
        >Send vehicle details</button
      >
      <span class="field-hint">Required fields are marked with an asterisk.</span>
    </div>
    <p class="form-status" role="status" aria-live="polite" tabindex="-1" data-form-status></p>
  </form>
</div>

{
  siteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}
