---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import { business } from '@/data/site';
---
<BaseLayout title="Customer Reviews | Merritt's Auto Recycling" description="Read Merritt's customer reviews on Google, learn what to ask before selling a vehicle, and share honest feedback after working with our Twin Cities business." path="/reviews">
  <PageHero eyebrow="Hear from vehicle owners" title="Customer experiences with Merritt’s" description="Choosing a vehicle buyer is easier when you know what others experienced. Read customer feedback on our Google Business Profile, then call with your own questions." crumbs={[{ label: 'Home', href: '/' }, { label: 'Reviews' }]}>
    <a class="button" href={business.googleBusinessProfile} target="_blank" rel="noopener noreferrer" data-track="review_profile_click">Read reviews on Google <Icon name="arrow" /></a>
  </PageHero>
  <section class="section section--paper"><div class="container split">
    <div class="flow"><p class="eyebrow">Before you decide</p><h2>Ask about the complete experience</h2><p class="lede">Look for feedback about communication, clear offers, pickup arrangements, and how questions were handled. Ask us how those details would work for your vehicle.</p><p>We discuss condition, documents, removal charges, payment arrangements, and access before scheduling. That gives you a clear agreement to review rather than a number without the pickup details.</p><a class="text-link" href="/cash-for-junk-cars">Learn how selling works <Icon name="arrow" /></a></div>
    <div class="card flow"><h2>Already worked with Merritt’s?</h2><p>Your honest feedback helps other local vehicle owners know what to expect. Visit our Google profile and choose the option to write a review.</p><p>Describe your own experience in your own words. Please leave vehicle identification numbers, addresses, and other private information out of public reviews and photos.</p><a class="button button--dark" href={business.googleBusinessProfile} target="_blank" rel="noopener noreferrer" data-track="review_profile_click">Visit our Google profile <Icon name="arrow" /></a></div>
  </div></section>
  <CtaBand title="Have a question before selling?" text="Call or text us about the vehicle, your location, and what you need to know before deciding." />
</BaseLayout>
