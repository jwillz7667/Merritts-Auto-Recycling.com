---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import { business } from '@/data/site';

const path = '/reviews';
---

<BaseLayout
  title="Customer Reviews | Merritt's Auto Recycling"
  description="Visit Merritt's verified Google Business Profile to read current customer feedback or leave a review after working with the business."
  path={path}
>
  <PageHero
    eyebrow="Feedback from the source"
    title="Read current reviews on Google"
    description="See what customers share about working with Merritt’s Auto Recycling. Visit our Google profile to read current reviews and business details."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Reviews' }]}
  />

  <section class="section section--paper">
    <div class="container--narrow flow">
      <p class="eyebrow">Customer experiences</p>
      <h2>Read feedback from vehicle owners</h2>
      <p class="lede">
        Read customer feedback on Google as you consider selling an unwanted vehicle. If you have
        worked with Merritt’s, you can share an honest review of your experience there too.
      </p>
      <div class="card">
        <h3>Google Business Profile</h3>
        <p>
          Read the latest available customer feedback, check profile details, or leave a review.
        </p>
        <a
          class="button button--dark"
          href={business.googleBusinessProfile}
          rel="noopener noreferrer"
        >
          Open the Google profile <Icon name="arrow" />
        </a>
      </div>
      <p class="notice">
        Questions about an offer or a scheduled pickup? Call Merritt’s directly at {business.phone}
        so we can discuss your vehicle and the next step.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
