---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import { business } from '@/data/site';
const path = '/contact';
const schema = { '@type': 'ContactPage', '@id': `${business.siteUrl}${path}#webpage`, url: `${business.siteUrl}${path}`, name: "Contact Merritt's Auto Recycling", about: { '@id': `${business.siteUrl}/#business` } };
---
<BaseLayout title="Contact Merritt's Auto Recycling | Brooklyn Center, MN" description="Call 763-533-2775, text 763-438-2116, or send Merritt’s your vehicle details online. Discuss a sale and pickup in the Twin Cities, daily 8 AM–8 PM." path={path} schema={schema}>
  <PageHero eyebrow="Call, text, or send your vehicle details" title="Contact Merritt’s Auto Recycling" description="Ready to sell an unwanted car? Call, text, or use the secure form below. Tell us what you have and its pickup city, and we will discuss the offer and next step." crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}>
    <div class="button-row"><a class="button" href={business.phoneUri} data-track="call_click"><Icon name="phone" /> Call {business.phone}</a><a class="button button--outline-light" href={business.textUri} data-track="text_click"><Icon name="message" /> Text {business.textPhone}</a></div>
  </PageHero>
  <section class="section section--soft"><div class="container contact-grid">
    <aside class="flow" aria-labelledby="contact-details-heading">
      <p class="eyebrow">Business details</p><h2 id="contact-details-heading">Talk with Merritt’s</h2>
      <ul class="contact-list">
        <li><small>Call</small><a href={business.phoneUri} data-track="call_click">{business.phone}</a></li>
        <li><small>Text</small><a href={business.textUri} data-track="text_click">{business.textPhone}</a></li>
        <li><small>Email</small><a href={`mailto:${business.email}`}>{business.email}</a></li>
        <li><small>Hours</small><strong>{business.hoursDisplay}</strong></li>
        <li><small>Business base</small><a href={business.googleMaps} rel="noopener noreferrer">{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}</a></li>
      </ul>
      <p>Call before visiting or arranging a vehicle drop-off. A vehicle inquiry is not a pickup booking. We agree on the offer, payment arrangements, documents and schedule directly.</p>
      <p><a href="/service-areas">Find your city’s pickup information</a></p>
      <a class="button button--outline" href={business.googleMaps} rel="noopener noreferrer"><Icon name="map" /> Open directions</a>
      <p class="notice">Vehicle removal is for cars we agree to buy or recycle, not emergency roadside dispatch.</p>
    </aside>
    <ContactForm />
  </div></section>
</BaseLayout>
