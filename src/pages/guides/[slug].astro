---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BuyerComparison from '@/components/BuyerComparison.astro';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { guides, type Guide } from '@/data/guides';
import { business } from '@/data/site';
export const getStaticPaths = (() => guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }))) satisfies GetStaticPaths;
interface Props { guide: Guide }
const { guide } = Astro.props;
const path = `/guides/${guide.slug}`;
const related = (guide.related ?? ['what-affects-a-junk-car-offer', 'minnesota-junk-car-documents']).filter((slug) => slug !== guide.slug).map((slug) => guides.find((item) => item.slug === slug)).filter((item): item is Guide => Boolean(item));
const sectionId = (index: number) => `section-${index + 1}`;
const schema = [
  { '@type': 'Article', '@id': `${business.siteUrl}${path}#article`, headline: guide.title, description: guide.description, mainEntityOfPage: `${business.siteUrl}${path}`, dateModified: guide.updatedIso, datePublished: guide.publishedIso, author: { '@id': `${business.siteUrl}/#business` }, publisher: { '@id': `${business.siteUrl}/#business` }, inLanguage: 'en-US' },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.siteUrl}/` }, { '@type': 'ListItem', position: 2, name: 'Guides', item: `${business.siteUrl}/guides` }, { '@type': 'ListItem', position: 3, name: guide.shortTitle, item: `${business.siteUrl}${path}` }] },
];
---
<BaseLayout title={guide.seoTitle ?? `${guide.title} | Merritt's Auto Recycling`} description={guide.description} path={path} schema={schema}>
  <PageHero eyebrow={guide.comparison ? 'A buyer comparison by Merritt’s' : 'Merritt’s vehicle-selling guide'} title={guide.title} description={guide.summary} crumbs={[{ label: 'Home', href: '/' }, { label: 'Guides', href: '/guides' }, { label: guide.shortTitle }]}>
    {guide.comparison && <p class="comparison-disclosure">{guide.comparison.disclosure}</p>}
    <ul class="guide-meta" aria-label="Article information"><li>Updated <time datetime={guide.updatedIso}>{guide.updated}</time></li><li>{guide.readingTime}</li></ul>
  </PageHero>
  <article class="section section--paper"><div class="container article-layout">
    <div class="article-body">
      {guide.comparison && <BuyerComparison comparison={guide.comparison} />}
      {guide.sections.map((section, index) => <section aria-labelledby={sectionId(index)}><h2 id={sectionId(index)}>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}</section>)}
    </div>
    <aside class="article-aside" aria-label="Guide navigation and sources"><h2>In this guide</h2><nav aria-label="Article contents"><ol>{guide.comparison && <li><a href="#comparison-heading">Compare published service information</a></li>}{guide.sections.map((section, index) => <li><a href={`#${sectionId(index)}`}>{section.heading}</a></li>)}</ol></nav>
      {guide.sources.length > 0 && <><h2>{guide.comparison ? 'Sources and published policies' : 'Official resources'}</h2><ul class="source-list">{guide.sources.map((source) => <li><a href={source.href} target={source.href.startsWith('https://') ? '_blank' : undefined} rel={source.href.startsWith('https://') ? 'noopener noreferrer' : undefined}>{source.label}</a></li>)}</ul></>}
      <h2>Ask Merritt’s about your vehicle</h2><p>Call <a href={business.phoneUri} data-track="call_click">{business.phone}</a> or text <a href={business.textUri} data-track="text_click">{business.textPhone}</a> with the condition and pickup city.</p><p><a href="/service-areas">Check metro service areas</a></p>
    </aside>
  </div></article>
  <section class="section section--soft"><div class="container flow"><h2>Continue planning your sale</h2><div class="card-grid">{related.map((item) => <article class="card"><h3>{item.shortTitle}</h3><p>{item.description}</p><a class="text-link" href={`/guides/${item.slug}`}>{item.shortTitle} <Icon name="arrow" /></a></article>)}</div></div></section>
  <CtaBand title={guide.comparison ? 'Ask Merritt’s for a vehicle-specific offer' : undefined} />
</BaseLayout>
<style>
  .comparison-disclosure { max-width: 48rem; margin: 0 0 1.5rem; color: #d7e0e8; line-height: 1.65; }
  .article-body { min-width: 0; }
</style>
