---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import { guides } from '@/data/guides';
import { business } from '@/data/site';
const path = '/guides';
const title = "Junk Car Value, Pickup and Buyer Guides | Merritt's";
const schema = {
  '@type': 'CollectionPage', '@id': `${business.siteUrl}${path}#webpage`,
  url: `${business.siteUrl}${path}`, name: title,
  hasPart: guides.map((guide) => ({ '@type': 'Article', headline: guide.title, url: `${business.siteUrl}/guides/${guide.slug}` })),
};
---
<BaseLayout title={title} description="Find answers about junk-car value, selling a non-running car, Minnesota documents, pickup, and comparing buyers. Practical guides from Merritt’s." path={path} schema={schema}>
  <PageHero eyebrow="Plan your vehicle sale" title="What is your junk car worth, and how do you sell it?" description="Compare your options, prepare for pickup, and understand what to ask a buyer. Start with the question that fits your vehicle." crumbs={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
  <section class="section section--paper"><div class="container"><div class="card-grid">
    {guides.map((guide, index) => <article class="card service-card"><div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div><p class="area-tag">{guide.comparison ? 'Buyer comparison' : guide.readingTime}</p><h2>{guide.shortTitle}</h2><p>{guide.description}</p><a class="text-link" href={`/guides/${guide.slug}`}>{guide.shortTitle} <Icon name="arrow" /></a></article>)}
  </div></div></section>
  <section class="section section--soft"><div class="container--narrow flow"><p class="eyebrow">Make the next conversation count</p><h2>Bring your vehicle’s details to the comparison</h2><p class="lede">Year, make, model, known problems, missing parts, title status, and pickup access give a buyer something specific to evaluate. Compare the amount you would receive and the agreed removal terms, not just a headline number.</p><p>Use the linked Minnesota agency resources for official document and environmental requirements. A buyer comparison describes published policies, not a test of either business’s service.</p></div></section>
  <CtaBand />
</BaseLayout>
