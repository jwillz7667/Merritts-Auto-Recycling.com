---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CoverageDirectory from '@/components/CoverageDirectory.astro';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import Picture from '@/components/Picture.astro';
import { business } from '@/data/site';
const path = '/about';
const schema = { '@type': 'AboutPage', '@id': `${business.siteUrl}${path}#webpage`, url: `${business.siteUrl}${path}`, name: "About Merritt's Auto Recycling", about: { '@id': `${business.siteUrl}/#business` } };
---
<BaseLayout title="About Merritt's Auto Recycling | Serving Since 1988" description="Founded by Brad Emholtz in 1988, Merritt's Auto Recycling is based in Brooklyn Center and serves vehicle owners across Minneapolis, St. Paul and the Twin Cities." path={path} schema={schema}>
  <PageHero eyebrow="Established in 1988" title="A local name for your vehicle’s next chapter" description="Founded by Brad Emholtz, Merritt’s Auto Recycling helps Twin Cities vehicle owners discuss selling unwanted cars and arranging pickup." crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
  <section class="section section--paper"><div class="container split"><div class="flow"><p class="eyebrow">Brooklyn Center roots. Metro-wide service.</p><h2>Serving vehicle owners since 1988</h2><p class="lede">An unused car can take up space long after it stops being useful. A major repair can make keeping a truck impractical. We help you explore another option without repairing or moving the vehicle before the first conversation.</p><p>Call or text the condition and pickup location. We ask about the details that matter, explain the offer and removal terms, and discuss the documents and scheduling. You decide whether the agreement works for you.</p><p>Our business address is {business.address.street}, {business.address.city}, {business.address.region} {business.address.postalCode}. Call before planning a visit or vehicle drop-off.</p></div><div class="media-frame"><Picture src="/images/legacy/merritts-tow-truck.jpg" avif="/images/legacy/merritts-tow-truck.avif" webp="/images/legacy/merritts-tow-truck.webp" alt="A Merritt's Auto Recycling truck carrying a vehicle" width={1600} height={1070} /></div></div></section>
  <section class="section section--soft"><div class="container"><div class="card-grid"><article class="card"><p class="eyebrow">Founded</p><h2>1988</h2><p>Established by Brad Emholtz.</p></article><article class="card"><p class="eyebrow">Home base</p><h2>Brooklyn Center</h2><p>Serving Minneapolis, St. Paul and surrounding communities.</p></article><article class="card"><p class="eyebrow">Contact hours</p><h2>Every day</h2><p>8:00 AM–8:00 PM for your vehicle questions.</p></article></div></div></section>
  <section class="section section--paper"><div class="container flow"><h2>Find your community</h2><p>Review local pickup information or browse our full metro service directory.</p><CoverageDirectory compact /></div></section>
  <CtaBand />
</BaseLayout>
