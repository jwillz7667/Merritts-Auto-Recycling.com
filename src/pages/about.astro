---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import PageHero from '@/components/PageHero.astro';
import Picture from '@/components/Picture.astro';
import { business } from '@/data/site';

const path = '/about';
const schema = {
  '@type': 'AboutPage',
  '@id': `${business.siteUrl}${path}#webpage`,
  url: `${business.siteUrl}${path}`,
  name: "About Merritt's Auto Recycling",
  about: { '@id': `${business.siteUrl}/#business` },
};
---

<BaseLayout
  title="About Merritt's Auto Recycling | Brooklyn Center, MN"
  description="Merritt's Auto Recycling was founded in 1988 and is based at 3106 68th Ave N in Brooklyn Center, Minnesota."
  path={path}
  schema={schema}
>
  <PageHero
    eyebrow="Established in 1988"
    title="A Brooklyn Center auto recycling business since 1988"
    description="Founded by Brad Emholtz in 1988, Merritt’s Auto Recycling is based in Brooklyn Center and serves vehicle owners throughout the Twin Cities metro area and surrounding suburbs."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
  />

  <section class="section section--paper">
    <div class="container split">
      <div class="flow">
        <p class="eyebrow">Local auto recycling</p>
        <h2>Serving vehicle owners since 1988</h2>
        <p class="lede">
          Merritt’s Auto Recycling was founded in 1988 by Brad Emholtz. The business address is
          {
            ` ${business.address.street}, ${business.address.city}, ${business.address.region} ${business.address.postalCode}`
          }.
        </p>
        <p>
          Have an unwanted car, truck, van, or SUV? Contact Merritt’s to discuss the vehicle’s
          condition, a cash offer, and removal from your location.
        </p>
        <p>
          Call or text during daily business hours, 8:00 AM–8:00 PM. Have the year, make, model,
          pickup address, and title status ready so we can explain the next steps.
        </p>
      </div>
      <div class="media-frame">
        <Picture
          src="/images/legacy/merritts-tow-truck.jpg"
          avif="/images/legacy/merritts-tow-truck.avif"
          webp="/images/legacy/merritts-tow-truck.webp"
          alt="A Merritt's Auto Recycling truck carrying a vehicle"
          width={1600}
          height={1070}
        />
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="card-grid">
        <article class="card">
          <p class="eyebrow">Founded</p><h2>1988</h2><p>Serving vehicle owners since 1988.</p>
        </article>
        <article class="card">
          <p class="eyebrow">Founder</p><h2>Brad Emholtz</h2><p>
            Founded Merritt’s Auto Recycling in 1988.
          </p>
        </article>
        <article class="card">
          <p class="eyebrow">Home base</p><h2>Brooklyn Center</h2><p>
            Our home base for service across the Twin Cities metro and surrounding suburbs.
          </p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
