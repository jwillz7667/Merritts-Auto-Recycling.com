---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import CoverageDirectory from '@/components/CoverageDirectory.astro';
import FaqList from '@/components/FaqList.astro';
import Icon from '@/components/Icon.astro';
import Picture from '@/components/Picture.astro';
import { business, globalFaqs, homeSeo, services } from '@/data/site';
const schema = {
  '@type': 'WebPage', '@id': `${business.siteUrl}/#webpage`, url: `${business.siteUrl}/`,
  name: homeSeo.title, description: homeSeo.description,
  isPartOf: { '@id': `${business.siteUrl}/#website` }, about: { '@id': `${business.siteUrl}/#business` },
};
---
<BaseLayout title={homeSeo.title} description={homeSeo.description} path="/" schema={schema}>
  <section class="hero" aria-labelledby="home-heading">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow eyebrow--light">Minneapolis · St. Paul · Surrounding suburbs</p>
        <h1 id="home-heading">{homeSeo.heading}</h1>
        <p class="lede lede--light">Have an unwanted car, truck, van or SUV? Tell us about the vehicle and where it is located. Merritt’s will explain your cash offer and pickup options.</p>
        <div class="button-row">
          <a class="button" href={business.phoneUri} data-track="call_click"><Icon name="phone" /> Call {business.phone}</a>
          <a class="button button--outline-light" href={business.textUri} data-track="text_click"><Icon name="message" /> Text {business.textPhone}</a>
        </div>
        <p class="hero-help">Text the year, make, model, condition, pickup city, and title status. Current vehicle photos help.</p>
        <ul class="trust-list" aria-label="Business facts">
          <li><strong>Since 1988</strong><span>Established local business</span></li>
          <li><strong>Daily hours</strong><span>8:00 AM–8:00 PM</span></li>
          <li><strong>Twin Cities</strong><span>Based in Brooklyn Center</span></li>
        </ul>
      </div>
      <div class="hero-media">
        <Picture src="/images/legacy/merritts-tow-truck.jpg" avif="/images/legacy/merritts-tow-truck.avif" webp="/images/legacy/merritts-tow-truck.webp" alt="A Merritt's Auto Recycling truck carrying a red vehicle" width={1600} height={1070} loading="eager" fetchpriority="high" />
        <div class="hero-proof"><span>Your local vehicle buyer</span><strong>Merritt’s Auto Recycling</strong><small>Serving vehicle owners since 1988</small></div>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="trust-heading">
    <div class="container split">
      <div class="flow">
        <p class="eyebrow">Know who you are calling</p>
        <h2 id="trust-heading">A local business. A direct conversation.</h2>
        <p class="lede">Merritt’s was founded by Brad Emholtz in 1988. From our Brooklyn Center base, we work with vehicle owners throughout Minneapolis, St. Paul and the metro suburbs.</p>
        <p>Ask about the offer, documents, payment arrangements, and pickup in the same conversation. You decide whether to proceed once the terms are clear.</p>
      </div>
      <div class="card flow">
        <h3>Hear from our customers</h3>
        <p>Read customer experiences on our Google Business Profile before deciding who to contact.</p>
        <a class="text-link" href={business.googleBusinessProfile} target="_blank" rel="noopener noreferrer" data-track="review_profile_click">Read reviews on Google <Icon name="arrow" /></a>
        <a class="text-link" href="/about">Meet Merritt’s <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="steps-heading">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow eyebrow--light">How it works</p><h2 id="steps-heading">From unwanted car to an agreed pickup</h2></div><p class="lede lede--light">No need to guess a price or arrange a separate tow before calling.</p></div>
      <ol class="steps">
        <li class="step"><h3>Tell us about the vehicle</h3><p>Call or text the year, make, model, condition, location, and whether you have the title and keys.</p></li>
        <li class="step"><h3>Review your offer</h3><p>We explain the offer, any removal charges, payment arrangements, and documents needed. You choose whether to accept.</p></li>
        <li class="step"><h3>Arrange pickup</h3><p>Agree on access and a pickup window. Remove your belongings and have the agreed documents and keys ready.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="vehicles-heading">
    <div class="container split">
      <div class="flow">
        <p class="eyebrow">Selling it as it is</p>
        <h2 id="vehicles-heading">Running, damaged, or no longer worth repairing?</h2>
        <p class="lede">You can ask about a vehicle in its current condition. Describe what you know so we can review the car and the pickup setting together.</p>
        <ul class="vehicle-grid" aria-label="Vehicles considered"><li>Non-running cars</li><li>Damaged vehicles</li><li>Older trucks</li><li>Unwanted SUVs</li><li>Cars with flat tires</li><li>Incomplete vehicles</li><li>Vans</li><li>Vehicles stored at a shop</li></ul>
        <p>Missing title or keys? Mention that before scheduling so we can address documents and access separately.</p>
        <a class="text-link" href="/guides/non-running-car-removal-checklist">Check what to share about a non-running car <Icon name="arrow" /></a>
      </div>
      <div class="media-frame"><Picture src="/images/legacy/junk-car-removal.jpg" alt="A vehicle secured on a flatbed tow truck" width={1920} height={865} /></div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="areas-heading">
    <div class="container flow">
      <p class="eyebrow">Across the metro</p><h2 id="areas-heading">Minneapolis, St. Paul and the surrounding suburbs</h2>
      <p class="lede">Find pickup information for your part of the Twin Cities. Our directory covers the northwest, north, west, south, and east metro, plus surrounding communities.</p>
      <CoverageDirectory compact />
      <p>Send the exact vehicle location to confirm availability and pickup terms. A garage, shared lot, or difficult approach can affect the loading plan.</p>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="services-heading">
    <div class="container"><div class="section-heading"><div><p class="eyebrow">Choose your next step</p><h2 id="services-heading">Sell it. Arrange pickup. Learn about recycling.</h2></div></div>
      <div class="card-grid">{services.slice(0, 3).map((service, index) => <article class="card service-card"><div class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div><h3>{service.name}</h3><p>{service.summary}</p><a class="text-link" href={`/${service.slug}`}>Explore {service.name.toLowerCase()} <Icon name="arrow" /></a></article>)}</div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="guide-heading">
    <div class="container flow"><p class="eyebrow">Before you sell</p><h2 id="guide-heading">Answers that make the first call easier</h2>
      <div class="card-grid">
        <article class="card"><h3>What is my junk car worth?</h3><p>Understand condition, completeness, pickup costs, and why weight alone is not a cash offer.</p><a class="text-link" href="/guides/what-affects-a-junk-car-offer">Understand your offer <Icon name="arrow" /></a></article>
        <article class="card"><h3>What documents will I need?</h3><p>Prepare your title and ownership questions, including missing documents or a lien.</p><a class="text-link" href="/guides/minnesota-junk-car-documents">Review the document checklist <Icon name="arrow" /></a></article>
        <article class="card"><h3>How do I prepare for pickup?</h3><p>Get belongings, access, keys, and the agreed paperwork ready without unsafe repairs or towing.</p><a class="text-link" href="/guides/prepare-an-unwanted-car-for-pickup">Read the pickup checklist <Icon name="arrow" /></a></article>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="faq-heading"><div class="container--narrow"><p class="eyebrow">Straight answers</p><h2 id="faq-heading">Questions about selling your car</h2><FaqList faqs={[globalFaqs[1]!, globalFaqs[2]!, globalFaqs[4]!, globalFaqs[5]!, globalFaqs[6]!]} /><p style="margin-top: 1.5rem;"><a class="text-link" href="/faq">All questions <Icon name="arrow" /></a></p></div></section>
  <CtaBand title="Tell us about the car you want to sell" text="Call or text during daily business hours, 8:00 AM–8:00 PM. Start with the vehicle details and pickup city." />
</BaseLayout>
<style>.hero-help { color: #fff; font-size: .95rem; max-width: 42rem; margin-top: 1.25rem; }</style>
