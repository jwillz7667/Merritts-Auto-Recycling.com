---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { business } from '@/data/site';
import { serviceRegions } from '@/data/service-regions';
---
<BaseLayout title="Regional Junk Car Pickup and Selling Guides | Merritt's" description="Explore Merritt’s county and regional vehicle-selling information, with local pickup links, ownership guidance and clear extended-area availability checks." path="/service-regions">
  <PageHero eyebrow="Regional information" title="Find the right pickup and vehicle-selling information" description="Browse county and surrounding-area guides. Merritt’s is based in Brooklyn Center; extended-area availability is reviewed for the actual vehicle and address." crumbs={[{ label: 'Home', href: '/' }, { label: 'Service areas', href: '/service-areas' }, { label: 'Regional guides' }]}>
    <div class="button-row"><a class="button" href={business.phoneUri} data-track="call_click"><Icon name="phone" /> Call {business.phone}</a><a class="button button--outline-light" href={business.textUri} data-track="text_click"><Icon name="message" /> Text {business.textPhone}</a></div>
  </PageHero>
  <section class="section section--paper"><div class="container card-grid">{serviceRegions.map((region) => <article class="card"><h2>{region.name}</h2><p>{region.intro}</p><a class="text-link" href={`/service-regions/${region.slug}`}>Read {region.name} information</a></article>)}</div></section>
  <CtaBand />
</BaseLayout>
<style>.card h2 { font-size: 1.5rem; line-height: 1.2; }</style>
