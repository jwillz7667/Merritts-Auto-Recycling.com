# =============================================================================
# Merritt's Auto Recycling — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, or set these variables
# in the Vercel dashboard (Project Settings → Environment Variables) for
# preview and production deployments. Do NOT commit `.env` or `.env.local`.
#
# Required vars are enforced at boot by api/_lib/env.ts and apply-env.mts —
# a misconfigured deploy will crash loudly rather than silently dropping
# form submissions.
# =============================================================================

# -----------------------------------------------------------------------------
# Resend — transactional email (required)
# -----------------------------------------------------------------------------
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender domain — must be a domain you've verified in Resend
RESEND_FROM_EMAIL=noreply@merritts-auto-recycling.com

# Where contact / quote / appointment form submissions are delivered
RECIPIENT_EMAIL=merrittsautorecycling@gmail.com

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — bot protection (required for forms)
# -----------------------------------------------------------------------------
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public site key — injected into HTML at build time by scripts/apply-env.mts
TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Server-side request origin allowlist (required in production)
# -----------------------------------------------------------------------------
# In production, set to https://merritts-auto-recycling.com. In dev,
# leaving unset allows localhost / vercel preview URLs.
ALLOWED_ORIGIN=https://merritts-auto-recycling.com

# -----------------------------------------------------------------------------
# Google Maps Platform (optional — Maps embed on contact + service area)
# -----------------------------------------------------------------------------
# Get from https://console.cloud.google.com/apis/credentials
# IMPORTANT: restrict by HTTP referrer to *.merritts-auto-recycling.com/*
GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# IndexNow — push notifications to Bing & Yandex on deploy (optional)
# -----------------------------------------------------------------------------
# Any random alphanumeric string (8-128 chars). Generate one and submit at
# https://www.bing.com/indexnow. The key file gets emitted at the site root
# by scripts/apply-env.mts as /{INDEXNOW_KEY}.txt.
INDEXNOW_KEY=

# -----------------------------------------------------------------------------
# Operational alerting (optional)
# -----------------------------------------------------------------------------
# If set, form-submission failures and 5xx errors are POSTed here.
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Runtime selectors (managed by Vercel — do not set manually in production)
# -----------------------------------------------------------------------------
# NODE_ENV is set by Vercel automatically. Override for local dev only.
NODE_ENV=development
