; EditorConfig — https://editorconfig.org
; Top-level config — every contributor's editor reads this on file open.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{ts,mts,tsx,js,mjs,cjs,jsx,json,jsonc}]
indent_style = space
indent_size = 2

[*.{html,css,scss,sass}]
indent_style = tab
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[{LICENSE,NOTICE}]
indent_style = space
trim_trailing_whitespace = false
max_line_length = off

[package.json]
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf
